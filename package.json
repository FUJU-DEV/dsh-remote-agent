{
  "name": "dsh-remote-agent",
  "version": "0.2.0",
  "description": "Remote agent bridge for DeepSeek Harness: call another agent harness on a remote server via SSH or HTTP, with background jobs, process-group cancellation, endpoint presets, and DSH session continuity.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FUJU-DEV/dsh-remote-agent.git"
  },
  "homepage": "https://github.com/FUJU-DEV/dsh-remote-agent#readme",
  "bugs": {
    "url": "https://github.com/FUJU-DEV/dsh-remote-agent/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-remote-agent-server": "./server/remote-agent-server.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "server",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "remote-agent",
    "remote-dsh",
    "ssh",
    "mcp",
    "agent-bridge"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-jobs": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
